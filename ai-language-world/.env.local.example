# 复制这个文件为 .env.local，填入真实值

# ============ AI 供应商切换 ============
# 不设置 AI_PROVIDER 时默认走 Anthropic (Claude)
# AI_PROVIDER=anthropic

# --- 方案A：Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 可选：省测试额度可以用 Haiku
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- 方案B：免费/低成本的OpenAI兼容供应商 ---
# 想用 Groq / OpenRouter 这类免费额度测试时，取消下面的注释：
#
# AI_PROVIDER=openai_compatible
#
# 用 Groq（免费，速度快，Llama/Mixtral等开源模型）：
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_API_KEY=gsk_xxxxxxxx
# AI_MODEL=llama-3.3-70b-versatile
#
# 用 OpenRouter（免费模型池，一个key切换多家）：
# AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# AI_API_KEY=sk-or-xxxxxxxx
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============ Supabase ============
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx
